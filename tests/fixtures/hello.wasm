(module
  ;; Import fd_write dari WASI
  (import "wasi_unstable" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))

  ;; Memory minimal 1 halaman (64KB)
  (memory (export "memory") 1)

  ;; Data string "hello\n" pada offset 8
  (data (i32.const 8) "hello\n")

  ;; Fungsi utama (export sebagai _start)
  (func $main (export "_start")
    ;; Siapkan iovec: pointer ke offset 8, panjang 6
    (i32.store (i32.const 0) (i32.const 8))   ;; iov_base = 8
    (i32.store (i32.const 4) (i32.const 6))   ;; iov_len  = 6

    ;; Panggil fd_write(1, iovec, 1, nwritten)
    (call $fd_write
      (i32.const 1)   ;; file descriptor = stdout
      (i32.const 0)   ;; pointer ke iovec
      (i32.const 1)   ;; jumlah iovec
      (i32.const 16)  ;; pointer ke nwritten (lokasi 16)
    )
    drop  ;; abaikan return value
  )
)
